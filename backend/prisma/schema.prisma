generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum StatusLocacao {
  reservada
  retirada
  em_andamento
  devolvida
  finalizada
  cancelada
}
enum PapelUsuario {
  USER
  ADMIN
}
enum CambioVeiculo {
  manual
  automatico
}
enum CombustivelVeiculo {
  gasolina
  etanol
  flex
  diesel
  eletrico
  hibrido
}
enum FormaAquisicaoVeiculo {
  a_vista
  financiado
  leasing
}
enum StatusVeiculo {
  disponivel
  alugado
  reservado
  manutencao
  inativo
}
enum StatusSinistro {
  aberto
  em_andamento
  resolvido
}
enum StatusMulta {
  pendente
  paga
  contestada
}
enum TipoVistoria {
  saida
  entrada
}
model Usuario {
  id Int @id @default(autoincrement())
  nome String
  email String @unique
  senhaHash String
  criadoEm DateTime @default(now())
  papel PapelUsuario @default(USER)
  ativo Boolean @default(true)
  tokenVersion Int @default(0)
  locacoes Locacao[]
}
model CategoriaVeiculo {
  id Int @id @default(autoincrement())
  nome String @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  veiculos Veiculo[]
  franquias FranquiaCategoria[]
  caucoes CaucaoCategoria[]
  @@map("categorias_veiculo")
}
model Filial {
  id Int @id @default(autoincrement())
  nome String @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  veiculos Veiculo[]
  configuracoes ConfigFilial[]
  @@map("filiais")
}
model OpcionalVeiculo {
  id Int @id @default(autoincrement())
  nome String @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  veiculos VeiculoOpcional[]
  @@map("opcionais_veiculo")
}
model Veiculo {
  id Int @id @default(autoincrement())
  placa String @unique @db.VarChar(8)
  renavam String? @unique @db.VarChar(11)
  chassi String? @unique @db.VarChar(17)
  marca String @db.VarChar(50)
  modelo String @db.VarChar(80)
  versao String? @db.VarChar(80)
  anoFabricacao Int @default(2000) @map("ano_fabricacao") @db.SmallInt
  anoModelo Int @default(2000) @map("ano_modelo") @db.SmallInt
  cor String? @db.VarChar(30)
  categoriaId Int @map("categoria_id")
  cambio CambioVeiculo @default(manual)
  combustivel CombustivelVeiculo @default(flex)
  motor String? @db.VarChar(20)
  numPortas Int? @map("num_portas") @db.UnsignedTinyInt
  numPassageiros Int? @map("num_passageiros") @db.UnsignedTinyInt
  capacidadePortaMalas Int? @map("capacidade_porta_malas") @db.UnsignedSmallInt
  opcionais VeiculoOpcional[]
  dataCompra DateTime? @map("data_compra") @db.Date
  valorCompra Decimal? @map("valor_compra") @db.Decimal(12,2)
  formaAquisicao FormaAquisicaoVeiculo? @map("forma_aquisicao")
  valorFipe Decimal? @map("valor_fipe") @db.Decimal(12,2)
  valorRevendaEstimado Decimal? @map("valor_revenda_estimado") @db.Decimal(12,2)
  vidaUtilMeses Int? @map("vida_util_meses") @db.UnsignedSmallInt
  crlvVencimento DateTime? @map("crlv_vencimento") @db.Date
  ipvaVencimento DateTime? @map("ipva_vencimento") @db.Date
  licenciamentoVencimento DateTime? @map("licenciamento_vencimento") @db.Date
  seguradora String? @db.VarChar(80)
  apoliceNumero String? @map("apolice_numero") @db.VarChar(40)
  apoliceVencimento DateTime? @map("apolice_vencimento") @db.Date
  apoliceFranquia Decimal? @map("apolice_franquia") @db.Decimal(10,2)
  status StatusVeiculo @default(inativo)
  kmAtual Int @default(0) @map("km_atual") @db.UnsignedInt
  nivelCombustivel Int @default(0) @map("nivel_combustivel") @db.UnsignedTinyInt
  filialId Int @map("filial_id")
  proximaRevisaoKm Int? @map("proxima_revisao_km") @db.UnsignedInt
  proximaRevisaoData DateTime? @map("proxima_revisao_data") @db.Date
  valorDiaria Decimal @default(0) @db.Decimal(10,2)
  categoria CategoriaVeiculo @relation(fields: [categoriaId], references: [id])
  filial Filial @relation(fields: [filialId], references: [id])
  locacoes Locacao[]
  manutencoes Manutencao[]
  sinistros SinistroAvaria[]
  multas Multa[]
  vistorias Vistoria[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  @@index([categoriaId])
  @@index([filialId])
}
model VeiculoOpcional {
  veiculoId Int @map("veiculo_id")
  opcionalId Int @map("opcional_id")
  veiculo Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  opcional OpcionalVeiculo @relation(fields: [opcionalId], references: [id], onDelete: Restrict)
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  @@unique([veiculoId, opcionalId])
  @@map("veiculo_opcionais")
}
model Locacao {
  id Int @id @default(autoincrement())
  usuarioId Int
  veiculoId Int
  dataInicio DateTime
  dataPrevistaDevolucao DateTime
  dataDevolucaoEfetiva DateTime?
  valorTotal Decimal @db.Decimal(10,2)
  status StatusLocacao @default(reservada)
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  veiculo Veiculo @relation(fields: [veiculoId], references: [id])
  multas Multa[]
  vistorias Vistoria[]
  @@index([usuarioId])
  @@index([veiculoId])
}
model Manutencao {
  id Int @id @default(autoincrement())
  veiculoId Int @map("veiculo_id")
  data DateTime @db.Date
  tipo String @db.VarChar(50)
  descricao String? @db.Text
  valor Decimal? @db.Decimal(10,2)
  km Int? @db.UnsignedInt
  veiculo Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  @@index([veiculoId])
  @@map("manutencoes")
}
model SinistroAvaria {
  id Int @id @default(autoincrement())
  veiculoId Int @map("veiculo_id")
  data DateTime @db.Date
  descricao String @db.Text
  valorReparo Decimal? @map("valor_reparo") @db.Decimal(10,2)
  status StatusSinistro @default(aberto)
  veiculo Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  @@index([veiculoId])
  @@map("sinistros_avarias")
}
model Multa {
  id Int @id @default(autoincrement())
  veiculoId Int @map("veiculo_id")
  data DateTime @db.DateTime(3)
  infracao String @db.VarChar(120)
  valor Decimal @db.Decimal(10,2)
  status StatusMulta @default(pendente)
  locacaoId Int? @map("locacao_id")
  veiculo Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  locacao Locacao? @relation(fields: [locacaoId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  @@index([veiculoId])
  @@index([locacaoId])
  @@map("multas")
}
model Vistoria {
  id Int @id @default(autoincrement())
  veiculoId Int @map("veiculo_id")
  data DateTime @db.DateTime(3)
  tipo TipoVistoria
  km Int @db.UnsignedInt
  nivelCombustivel Int @map("nivel_combustivel") @db.UnsignedTinyInt
  observacoes String? @map("observacoes") @db.Text
  locacaoId Int? @map("locacao_id")
  veiculo Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  locacao Locacao? @relation(fields: [locacaoId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  @@index([veiculoId])
  @@index([locacaoId])
  @@map("vistorias")
}

enum PoliticaCombustivel {
  mesmo_nivel
  cobrar_reposicao
  tanque_cheio_pre_pago
}
enum TipoConfigFilial {
  retirada
  devolucao
}
model ConfiguracaoLocacao {
  id Int @id @default(1)
  periodoMinimoDiarias Int @default(1) @map("periodo_minimo_diarias") @db.UnsignedTinyInt
  periodoMaximoDiarias Int @default(30) @map("periodo_maximo_diarias") @db.UnsignedSmallInt
  horarioRetiradaPadrao DateTime @default("1970-01-01T09:00:00.000Z") @map("horario_retirada_padrao") @db.Time(0)
  horarioDevolucaoPadrao DateTime @default("1970-01-01T09:00:00.000Z") @map("horario_devolucao_padrao") @db.Time(0)
  toleranciaAtrasoMinutos Int @default(30) @map("tolerancia_atraso_minutos") @db.UnsignedSmallInt
  antecedenciaMinimaHoras Int @default(0) @map("antecedencia_minima_horas") @db.UnsignedSmallInt
  antecedenciaMaximaDias Int @default(365) @map("antecedencia_maxima_dias") @db.UnsignedSmallInt
  cancelamentoPrazoHoras Int @default(24) @map("cancelamento_prazo_horas") @db.UnsignedSmallInt
  cancelamentoMultaPercentual Decimal @default(0) @map("cancelamento_multa_percentual") @db.Decimal(5,2)
  idadeMinima Int @default(21) @map("idade_minima") @db.UnsignedTinyInt
  tempoMinimoCnhMeses Int @default(12) @map("tempo_minimo_cnh_meses") @db.UnsignedSmallInt
  documentosExigidos Json @map("documentos_exigidos")
  exigeCartaoCredito Boolean @default(true) @map("exige_cartao_credito")
  permiteMotoristaAdicional Boolean @default(false) @map("permite_motorista_adicional")
  maxMotoristasAdicionais Int @default(0) @map("max_motoristas_adicionais") @db.UnsignedTinyInt
  kmLivre Boolean @default(true) @map("km_livre")
  kmFranquiaDiaria Int? @map("km_franquia_diaria") @db.UnsignedInt
  politicaCombustivel PoliticaCombustivel @default(mesmo_nivel) @map("politica_combustivel")
  permiteDevolucaoOutraFilial Boolean @default(false) @map("permite_devolucao_outra_filial")
  permiteEntregaDomicilio Boolean @default(false) @map("permite_entrega_domicilio")
  permiteRetiradaAeroporto Boolean @default(false) @map("permite_retirada_aeroporto")
  raioEntregaKm Int? @map("raio_entrega_km") @db.UnsignedSmallInt
  protecaoBasicaInclusa Boolean @default(true) @map("protecao_basica_inclusa")
  exigeVistoriaSaida Boolean @default(true) @map("exige_vistoria_saida")
  exigeVistoriaEntrada Boolean @default(true) @map("exige_vistoria_entrada")
  modeloContrato String? @map("modelo_contrato") @db.LongText
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.DateTime(0)
  filiais ConfigFilial[]
  protecoes ProtecaoConfig[]
  checklist ChecklistItem[]
  franquias FranquiaCategoria[]
  caucoes CaucaoCategoria[]
  @@map("configuracoes_locacao")
}
model Protecao {
 id Int @id @default(autoincrement())
 nome String @db.VarChar(80)
 descricao String? @db.Text
 ativo Boolean @default(true)
 createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
 updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.DateTime(0)
 configuracoes ProtecaoConfig[]
 @@map("protecoes")
}
model ProtecaoConfig {
 configId Int @map("config_id")
 protecaoId Int @map("protecao_id")
 selecionada Boolean @default(false)
 createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
 updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.DateTime(0)
 config ConfiguracaoLocacao @relation(fields:[configId], references:[id], onDelete:Cascade)
 protecao Protecao @relation(fields:[protecaoId], references:[id], onDelete:Restrict)
 @@id([configId, protecaoId])
 @@map("config_protecoes")
}
model ConfigFilial {
 configId Int @map("config_id")
 filialId Int @map("filial_id")
 tipo TipoConfigFilial
 createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
 updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.DateTime(0)
 config ConfiguracaoLocacao @relation(fields:[configId], references:[id], onDelete:Cascade)
 filial Filial @relation(fields:[filialId], references:[id], onDelete:Restrict)
 @@id([configId, filialId, tipo])
 @@map("config_filiais")
}
model ChecklistItem {
 id Int @id @default(autoincrement())
 configId Int @map("config_id")
 descricao String @db.VarChar(120)
 obrigatorio Boolean @default(true)
 ordem Int @default(0) @db.UnsignedTinyInt
 ativo Boolean @default(true)
 createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
 updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.DateTime(0)
 config ConfiguracaoLocacao @relation(fields:[configId], references:[id], onDelete:Cascade)
 @@index([configId, ordem])
 @@map("checklist_itens")
}
model FranquiaCategoria {
 configId Int @map("config_id")
 categoriaId Int @map("categoria_id")
  valor Decimal @db.Decimal(10,2)
  config ConfiguracaoLocacao @relation(fields:[configId], references:[id], onDelete:Cascade)
  categoria CategoriaVeiculo @relation(fields:[categoriaId], references:[id], onDelete:Restrict)
  @@id([configId,categoriaId])
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.DateTime(0)
  @@map("franquias_categoria")
}
model CaucaoCategoria {
 configId Int @map("config_id")
 categoriaId Int @map("categoria_id")
  valor Decimal @db.Decimal(10,2)
  config ConfiguracaoLocacao @relation(fields:[configId], references:[id], onDelete:Cascade)
  categoria CategoriaVeiculo @relation(fields:[categoriaId], references:[id], onDelete:Restrict)
  @@id([configId,categoriaId])
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.DateTime(0)
  @@map("caucoes_categoria")
}
